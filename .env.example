# Copy this to .env and fill in your values
ANTHROPIC_API_KEY=your_api_key_here

# Your name / coaching brand (used in email signature)
COACH_NAME=Coach Don Jacks

# Optional: email subject prefix
EMAIL_SUBJECT_PREFIX=Weekly Coaching Insights

# -----------------------------------------------------------------------
# Zoom Server-to-Server OAuth credentials
# Create your app at: https://marketplace.zoom.us → Develop → Build App
# App type: Server-to-Server OAuth
# Required scope: recording:read:admin
# -----------------------------------------------------------------------
ZOOM_ACCOUNT_ID=your_account_id_here
ZOOM_CLIENT_ID=your_client_id_here
ZOOM_CLIENT_SECRET=your_client_secret_here
