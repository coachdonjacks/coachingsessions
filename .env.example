# Copy this to .env and fill in your values

# Claude API (get yours at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_api_key_here

# Your name / coaching brand (used in email signature)
COACH_NAME=Coach Don Jacks

# Optional: email subject prefix
EMAIL_SUBJECT_PREFIX=Weekly Coaching Insights

# -----------------------------------------------------------------------
# Zoom OAuth credentials
# (for fetching cloud recording transcripts directly from Zoom)
#
# Create a free "General App" at https://marketplace.zoom.us
#   Develop → Build App → General App
#   Add redirect URL: http://localhost:8080/callback
#   Add scope: cloud_recording:read:list_user_recordings (search "recording")
#   Copy Client ID and Client Secret below.
#
# Then run ONCE:  python3 fetch_zoom_transcripts.py --setup
# -----------------------------------------------------------------------
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# -----------------------------------------------------------------------
# Gmail credentials for SENDING the weekly email
#
# GMAIL_ADDRESS:    your full email address
# GMAIL_APP_PASSWORD: a 16-char App Password (NOT your normal password)
#   → Create one at: myaccount.google.com → Security → App passwords
#   → Requires 2-Step Verification to be enabled on your Google account
# -----------------------------------------------------------------------
GMAIL_ADDRESS=djacks@yourcoach.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who receives the weekly email (defaults to GMAIL_ADDRESS if not set)
EMAIL_RECIPIENT=djacks@yourcoach.com
